# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=production
PORT=5005

MONGO_URI=
JWT_SECRET=
JWT_EXPIRE=7d

ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

FRONTEND_URL=https://www.shubhamxerox.in
ADMIN_URL=
BACKEND_URL=

CORS_ORIGINS=
CORS_ALLOW_LOCALHOST=false
CORS_ALLOW_ALL=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=FSTSMS
OTP_TTL_MINUTES=5
GUEST_TOKEN_TTL=30m
OTP_DEV_MODE=false
OTP_DEV_FALLBACK=false

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_CHECKOUT_ENABLED=false
SHIPROCKET_CHECKOUT_ACCEPT_ORDERS=false
SHIPROCKET_CHECKOUT_API_KEY=
SHIPROCKET_CHECKOUT_API_SECRET=
# SHIPROCKET_API_KEY / SHIPROCKET_API_SECRET are accepted too, matching the
# older/reference Fastrr deployment. Set either pair, not both.
SHIPROCKET_CHECKOUT_ROUTE_PREFIX=/shiprocket-checkout
SHIPROCKET_CHECKOUT_UI_BASE_URL=https://fastrr-boost-ui.pickrr.com
SHIPROCKET_WEBHOOK_SECRET=
FASTRR_SELLER_DOMAIN=

# Instant catalogue update webhooks. Pull endpoints above remain the source
# of truth, while these optional URLs make admin edits appear immediately.
SHIPROCKET_AUTO_SYNC=true
FASTRR_PRODUCT_WEBHOOK_URL=
FASTRR_COLLECTION_WEBHOOK_URL=
FASTRR_API_KEY=
FASTRR_WEBHOOK_SECRET=

STORE_NAME=Subham Xerox
STORE_PINCODE=
STORE_CITY=
STORE_STATE=

UPLOAD_DIR=uploads
MAX_IMAGE_MB=15
MAX_PDF_MB=60
